# Copy to .env and fill in. Never commit .env. Placeholders only here.

# Qloo (server-side only). Host must be hackathon.api.qloo.com.
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=your-qloo-hackathon-key
# replay (default in dev and CI), record, or live
QLOO_MODE=replay
# remaining-call floor below which live calls are refused
QLOO_RESERVE=6000
# Food and places seed lookups: center as "lat,lon" and radius in miles (optional; defaults to New York, 20)
ATELIER_PLACES_LOCATION=40.7128,-74.0060
ATELIER_PLACES_RADIUS=20

# Anthropic (server-side only)
ANTHROPIC_API_KEY=your-anthropic-key
ATELIER_MODEL=claude-sonnet-5-5

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Site origin for magic-link redirects (https in production; http only on localhost)
SITE_URL=http://localhost:3000

# Reference layer: contact (email or project URL) for the Wikimedia User-Agent
ATELIER_CONTACT=your-contact-email-or-project-url

# Demo guard (src/proxy.ts). On in production; set ATELIER_GUARD=1 to try it in dev.
ATELIER_GUARD=
# Per-IP runs per hour, and daily worst-case call allowances before the demo rests
ATELIER_RUNS_PER_HOUR=3
ATELIER_DAILY_MODEL_CALLS=480
ATELIER_DAILY_QLOO_CALLS=480
# Set to 1 to force the calm "demo is resting" state
ATELIER_REST=
# Leave unset in the deployed demo so QLOO_RESERVE can rest it (1 bypasses the reserve)
ATELIER_DEMO=
