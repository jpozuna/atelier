# Copy to .env and fill in. Never commit .env. Placeholders only here.

# Qloo (server-side only). Host must be hackathon.api.qloo.com.
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=your-qloo-hackathon-key
# replay (default in dev and CI), record, or live
QLOO_MODE=replay
# remaining-call floor below which live calls are refused
QLOO_RESERVE=6000

# Anthropic (server-side only)
ANTHROPIC_API_KEY=your-anthropic-key
ATELIER_MODEL=claude-sonnet-5-5

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
