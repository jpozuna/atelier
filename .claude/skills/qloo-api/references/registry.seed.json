  "referenceOnly": {
    "applies_to": "all insights entity types unless noted; documented outside the per-type guide",
    "inParameterReference": [
      "feature.explainability",
      "page",
      "sort_by",
      "operator.signal.interests.tags",
      "signal.location",
      "signal.location.query",
      "signal.location.radius"
    ],
    "onlyInDeepDiveOpenApi": [
      "backfill.cross_domain.take",
      "backfill.content_based.take",
      "bias.content_based",
      "filter.exists",
      "signal.interests.entities.weight",
      "signal.interests.tags.weight",
      "signal.interests.entities.include",
      "filter.entities.query",
      "filter.release_date.min",
      "filter.release_date.max"
    ],
    "note": "A community project reported signal.location.query working for artists though the per-type guide omits it, so unlisted does not always mean ignored. Test each with and without."
  },
  "formats": {
    "filter.popularity.min/max": "number 0..1 percentile, closer to 1 is more popular",
    "take": "integer 1..50, default 20",
    "offset": "integer from 0",
    "page": "integer 1..100, default 1",
    "filter.exclude.entities / signal.interests.entities / filter.results.entities": "comma-separated entity ids on GET",
    "filter.tags / filter.exclude.tags / signal.interests.tags": "comma-separated tag ids from /v2/tags on GET",
    "operator.filter.tags / operator.exclude.tags": "union (default) or intersection",
    "operator.signal.interests.tags": "union = at least one tag, highest-affinity tag scores; intersection or empty = all tags, merged. The empty default is intersection",
    "bias.trends": "off | very_low | low | mid | medium | high | very_high. DEFAULT IS medium, so trending bias is on unless set",
    "feature.explainability": "boolean; adds query.explainability per result and for the set",
    "bias.content_based": "number 0..1, default 0.5; strength of content-based metadata in the affinity score (Deep Dive only)",
    "backfill.cross_domain.take": "integer 1..20, default 20; max cross-domain backfill results appended when primary results are insufficient (Deep Dive only)",
    "backfill.content_based.take": "integer 1..10, default 10; max content-based similarity results appended when other signals are unavailable (Deep Dive only)",
    "signal.interests.entities.weight / signal.interests.tags.weight": "number >= 0 or very_low|low|mid|medium|high|very_high. GROUP-level influence of that signal type versus the others, not per entity (Deep Dive only)",
    "filter.exists": "properties.image or properties.description: only entities that have it (Deep Dive only)"
  },
  "postOnly_doNotUse": [
    "per-entity weights: signal.interests.entities as [{entity, weight}] objects",
    "per-tag weights: signal.interests.tags as [{tag, weight}] objects",
    "signal.interests.entities.query",
    "filter.exclude.entities.query",
    "array form of filter.location.query / filter.exclude.location.query"
  ],
  "docConflicts": {
    "video_game_urn": "Developer Guide and per-type guide say urn:entity:video_game; the Deep Dive OpenAPI enum says urn:entity:videogame. Test before use. Not an Atelier domain.",
    "insights_filter_type_lists": "Deep Dive enum has locality (partial), heatmap, audience (deprecated) and no destination; Developer Guide lists destination and not locality; per-type guide also documents urn:tag. Test for a 403.",
    "exclude_tags_operator": "per-type guide and Parameter Reference name it operator.exclude.tags; Deep Dive names it operator.filter.exclude.tags. Default is union, which is what Atelier wants, so do not send either. If intersection is ever needed, test both names.",
    "filter.parents.types": "Parameter Reference says parental entity types; Deep Dive enum is audience URNs. Do not send.",
    "resy_params": "three different naming schemes across the three docs. Place-only, not needed by Atelier."
  },
  "responseEnvelope": {
    "insights": "{ success, results: { entities: [...], duration } } plus query metadata (query.explainability when requested, query.locality.signal for location queries). Entity item fields are not in the OpenAPI. Per-result affinity is probably at query.affinity (inferred from the heatmap description).",
    "search": "{ success, duration, results: [ ... ] }. results is a FLAT ARRAY of entities (artist, geolocational, movie, TV and videogame variants sharing common fields), not results.entities. Item fields are not in the OpenAPI. 404 means no results.",
    "tags": "{ success, duration, results: { tags: [...] } }",
    "tagInsights": "{ success, results: { tags: [ {tag_id, name, types[], subtype, tag_value, query{}} ] }, duration }. duration is top level here but inside results for entity insights.",
    "fixtureRule": "Fixtures need one synthetic shape per envelope above. The parser must not assume one envelope fits all.",
    "unknown": [
      "entity item fields (name, id, tags, popularity, images, description)",
      "how backfilled results are marked, if at all",
      "exact placement of explainability inside each entity"
    ]
  },
