{
  "name": "atelier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "evals": "ATELIER_EVALS_RUN=1 vitest run evals/harness/evals.cli.test.ts --reporter=verbose --passWithNoTests=false",
    "evals:live": "ATELIER_EVALS_LIVE=1 vitest run evals/harness/live.cli.test.ts --reporter=verbose --passWithNoTests=false",
    "evals:judges": "ATELIER_EVALS_JUDGES=1 vitest run evals/judges/judges.cli.test.ts --reporter=verbose --passWithNoTests=false"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
